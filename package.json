{
  "name": "betteraparri",
  "private": true,
  "version": "1.4.2",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:search-index",
    "dev": "vite",
    "build": "npm run generate:seo && npm run generate:search-index && tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "generate:seo": "node scripts/generate-seo-files.js",
    "generate:search-index": "node scripts/generate-search-index.js",
    "prepare": "husky",
    "convert-yaml": "node scripts/yaml-to-json.js",
    "import:barangays": "node scripts/import-barangays.js",
    "dev:yaml": "npm run convert-yaml && npm run dev",
    "setup": "node scripts/setup-starter-kit.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@bettergov/kapwa": "^1.2.4",
    "@tailwindcss/typography": "^0.5.18",
    "@types/js-yaml": "^4.0.9",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "js-yaml": "^4.1.0",
    "leaflet": "^1.9.4",
    "nuqs": "^2.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^15.7.3",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/leaflet": "^1.9.20",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.6"
  }
}
