{
  "_comment": "Column model for FAR No. 1 (SAAOBDB). The printed form has 24 columns; the first two -- Particulars and the UACS code -- are not money, so 22 money columns are expected. Column positions are not stored here because they move between scans; they are recovered per statement by pooling the right edges of every money token across that statement's pages, which yields these 22 in a stable order. This file fixes what the columns MEAN.",
  "series": "far1",
  "moneyColumns": 22,
  "fields": [
    { "col": 3, "key": "appropriations", "label": "Authorized Appropriations" },
    {
      "col": 4,
      "key": "adjustments",
      "label": "Adjustments (transfer to/from, modifications, augmentations)"
    },
    {
      "col": 5,
      "key": "adjustedAppropriations",
      "label": "Adjusted Appropriations",
      "derived": "appropriations + adjustments"
    },
    { "col": 6, "key": "allotmentsReceived", "label": "Allotments Received" },
    {
      "col": 7,
      "key": "allotmentAdjustments",
      "label": "Adjustments (reductions, modifications, augmentations)"
    },
    { "col": 8, "key": "transferTo", "label": "Transfer To" },
    { "col": 9, "key": "transferFrom", "label": "Transfer From" },
    {
      "col": 10,
      "key": "adjustedAllotments",
      "label": "Adjusted Allotments",
      "derived": "allotmentsReceived + allotmentAdjustments - transferTo + transferFrom"
    },
    {
      "col": 11,
      "key": "obligationsQ1",
      "label": "1st Quarter Ending March 31"
    },
    {
      "col": 12,
      "key": "obligationsQ2",
      "label": "2nd Quarter Ending June 30"
    },
    {
      "col": 13,
      "key": "obligationsQ3",
      "label": "3rd Quarter Ending September 30"
    },
    {
      "col": 14,
      "key": "obligationsQ4",
      "label": "4th Quarter Ending December 31"
    },
    {
      "col": 15,
      "key": "obligationsTotal",
      "label": "Total Obligations",
      "derived": "obligationsQ1..Q4"
    },
    {
      "col": 16,
      "key": "disbursementsQ1",
      "label": "1st Quarter Ending March 31"
    },
    {
      "col": 17,
      "key": "disbursementsQ2",
      "label": "2nd Quarter Ending June 30"
    },
    {
      "col": 18,
      "key": "disbursementsQ3",
      "label": "3rd Quarter Ending September 30"
    },
    {
      "col": 19,
      "key": "disbursementsQ4",
      "label": "4th Quarter Ending December 31"
    },
    {
      "col": 20,
      "key": "disbursementsTotal",
      "label": "Total Disbursements",
      "derived": "disbursementsQ1..Q4"
    },
    {
      "col": 21,
      "key": "unreleasedAppropriations",
      "label": "Unreleased Appropriations",
      "derived": "adjustedAppropriations - adjustedAllotments"
    },
    {
      "col": 22,
      "key": "unobligatedAllotments",
      "label": "Unobligated Allotments",
      "derived": "adjustedAllotments - obligationsTotal"
    },
    {
      "col": 23,
      "key": "unpaidObligationsDue",
      "label": "Unpaid Obligations: Due and Demandable"
    },
    {
      "col": 24,
      "key": "unpaidObligationsNotDue",
      "label": "Unpaid Obligations: Not Yet Due and Demandable"
    }
  ],
  "checks": [
    {
      "rule": "adjustedAppropriations = appropriations + adjustments",
      "lhs": "adjustedAppropriations",
      "sum": ["appropriations", "adjustments"]
    },
    {
      "rule": "obligationsTotal = Q1+Q2+Q3+Q4",
      "lhs": "obligationsTotal",
      "sum": [
        "obligationsQ1",
        "obligationsQ2",
        "obligationsQ3",
        "obligationsQ4"
      ]
    },
    {
      "rule": "disbursementsTotal = Q1+Q2+Q3+Q4",
      "lhs": "disbursementsTotal",
      "sum": [
        "disbursementsQ1",
        "disbursementsQ2",
        "disbursementsQ3",
        "disbursementsQ4"
      ]
    },
    {
      "rule": "unreleasedAppropriations = adjustedAppropriations - adjustedAllotments",
      "lhs": "unreleasedAppropriations",
      "diff": ["adjustedAppropriations", "adjustedAllotments"]
    },
    {
      "rule": "unobligatedAllotments = adjustedAllotments - obligationsTotal",
      "lhs": "unobligatedAllotments",
      "diff": ["adjustedAllotments", "obligationsTotal"]
    },
    {
      "rule": "unpaidObligations = obligationsTotal - disbursementsTotal",
      "lhsSum": ["unpaidObligationsDue", "unpaidObligationsNotDue"],
      "diff": ["obligationsTotal", "disbursementsTotal"]
    }
  ]
}
