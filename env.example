# Better Gattaran portal configuration
# Copy this file to .env.local for local development.

# Portal identity (kept separate from the government entity)
VITE_SITE_NAME="Better Gattaran"
VITE_SITE_DESCRIPTION="A community-driven civic information portal for Gattaran, Cagayan."

# Government referenced by the portal
VITE_GOVERNMENT_NAME="Municipality of Gattaran"
VITE_GOVERNMENT_TYPE="Municipality"
VITE_REGION="Region II - Cagayan Valley"
VITE_PROVINCE="Cagayan"

# Website Information
VITE_WEBSITE_URL=""
VITE_CONTACT_EMAIL=""
VITE_CONTACT_PHONE=""

# Content governance
VITE_ALLOW_SOURCED_CONTENT="true"
VITE_CORRECTION_REPORTS_ENABLED="true"
VITE_CORRECTION_ISSUE_URL="https://github.com/ginxFromYt/bettergattaran/issues/new"
VITE_CONTENT_REVERIFY_MONTHS="12"
# Used by `npm run content:audit` (defaults to 12 when unset)
CONTENT_REVERIFY_MONTHS="12"

# Public current-weather endpoint (no token required)
VITE_WEATHER_API_BASE_URL="https://cis-mock.ginxproduction.com/api"

# Social Media (Optional)
VITE_FACEBOOK_URL=""
VITE_TWITTER_URL=""
VITE_INSTAGRAM_URL=""
VITE_YOUTUBE_URL=""

# SEO
VITE_SITE_KEYWORDS="Gattaran, Cagayan, civic information, municipal services, community portal"
VITE_OG_IMAGE_URL=""
VITE_TWITTER_HANDLE=""

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=""
VITE_FACEBOOK_PIXEL_ID=""
