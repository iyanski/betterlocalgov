# Philippine Sports Commission Portal Configuration
# Copy this file to .env.local and update with your values

# Agency Information
VITE_GOVERNMENT_NAME="Philippine Sports Commission"
VITE_GOVERNMENT_TYPE="National Government Agency"
VITE_REGION="National Capital Region"
VITE_PROVINCE="Metro Manila"

# Website Information
VITE_WEBSITE_URL="https://psc.gov.ph"
# No general public email is published by PSC — only per-office addresses.
# officeofthechairman@psc.gov.ph is the closest to a general contact.
VITE_CONTACT_EMAIL=""
VITE_CONTACT_PHONE="8525-0808"

# Social Media (Optional)
VITE_FACEBOOK_URL=""
VITE_TWITTER_URL=""
VITE_INSTAGRAM_URL=""
VITE_YOUTUBE_URL=""

# SEO
VITE_SITE_DESCRIPTION="A community-built portal for the Philippine Sports Commission"
VITE_SITE_KEYWORDS="Philippine Sports Commission, PSC, Philippine sports, national athletes"
VITE_OG_IMAGE_URL=""
VITE_TWITTER_HANDLE=""

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=""
VITE_FACEBOOK_PIXEL_ID=""

# Meilisearch (Optional)
# The /search route only mounts when VITE_MEILISEARCH_HOST is set.
# VITE_ vars are exposed to the browser — never put the admin key here.
VITE_MEILISEARCH_HOST=""
VITE_MEILISEARCH_SEARCH_KEY=""
# Used only by `npm run index-content` (server side, not exposed):
MEILISEARCH_HOST=""
MEILISEARCH_ADMIN_KEY=""
